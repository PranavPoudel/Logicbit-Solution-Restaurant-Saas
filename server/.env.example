# Database
DATABASE_URL="postgresql://user:password@localhost:5432/logicbit?schema=public"

# App
PORT=3005
BRAND_NAME="LogicBit"
# MUST be "production" on the live server (Render): it turns on the production protections, e.g. SECRETS_ENCRYPTION_KEY becomes required.
# Keep "development" locally.
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
# Public address of the website, used in unsubscribe links (defaults to the first CORS_ORIGIN)
APP_URL="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-this-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# Media Upload (local disk by default; switch to S3-compatible in production)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# --- The following require YOUR business decisions & real credentials.
# --- Backend code is structured to plug these in later without refactoring.

# Payment Gateway (choose one: stripe / esewa / khalti)
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""

# SMS Provider (e.g. Twilio, Sparrow SMS)
SMS_PROVIDER=""
SMS_API_KEY=""

# Email over SMTP. Leave SMTP_HOST empty in development: emails are then only logged.
# For testing use a Mailtrap Email Sandbox (host sandbox.smtp.mailtrap.io, port 2525).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"   # "true" for port 465
SMTP_FROM=""          # e.g. LogicBit <no-reply@your-domain.com>; needs a verified domain in production

# Account security (emailed codes, lockout, Google login)
REQUIRE_EMAIL_VERIFICATION="true"  # "true": a new account must confirm its emailed code before it can log in
OTP_SECRET=""                       # signs the emailed codes; falls back to JWT_ACCESS_SECRET when empty
TRUST_PROXY=""                      # number of proxies in front of the API, e.g. 1 on Render; leave empty locally
BACKEND_URL=""                      # public address of this API, e.g. https://your-api.onrender.com (used for the Google redirect)
# "Continue with Google": create an OAuth client in Google Cloud Console and add this redirect URI to it:
#   <BACKEND_URL>/api/v1/customer-auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Claude API (for AI Chatbot, Phase 4-5)
ANTHROPIC_API_KEY=""

# Google Cloud Translation API (for menu multi-language auto-translate)
# Get from: Google Cloud Console → APIs & Services → Enable "Cloud Translation API" → Create API Key
GOOGLE_TRANSLATE_API_KEY=""

# Platform Staff Bootstrap (पहिलो Platform Admin — npm run prisma:seed चलाउँदा बन्छ)
PLATFORM_ADMIN_EMAIL="admin@logicbit.local"
PLATFORM_ADMIN_PASSWORD="ChangeMe123!"

# Shown in order confirmation emails (leave empty to omit)
SUPPORT_EMAIL=""

# Shared secret an external delivery service sends in the x-delivery-secret header (leave empty to refuse all delivery webhooks)
DELIVERY_WEBHOOK_SECRET=""

# Uber Direct: nothing to set here. Each restaurant adds its own Uber Direct account under Settings, so Uber bills the restaurant.
# Only to test against a stand-in for Uber (never in production):
# UBER_DIRECT_API_URL=
# UBER_DIRECT_AUTH_URL=

# PayPay (restaurant orders). Each restaurant adds its own keys under Settings > Payments.
# Sandbox by default; for live payments use https://apigw.paypay.ne.jp
PAYPAY_BASE_URL="https://apigw.sandbox.paypay.ne.jp"
# Encrypts the payment keys restaurants save (Stripe and PayPay secrets) in the database. REQUIRED in production:
# without it the server refuses to save or read those keys. Generate one with: openssl rand -base64 32
# Keep it safe and never change it while keys are saved, or they can no longer be read. Locally it can stay empty.
SECRETS_ENCRYPTION_KEY=""

# Card payments (Visa, Mastercard, JCB...) go through Stripe Checkout. There is no key here:
# each restaurant saves its own Stripe secret key (sk_test_... / sk_live_...) under Settings > Payments.
# FRONTEND_URL below is also where Stripe sends the customer back after paying, so it must be the public site address.
# Where PayPay sends the customer back after paying (the Next.js site)
FRONTEND_URL="http://localhost:3000"
