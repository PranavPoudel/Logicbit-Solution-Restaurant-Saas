# Database
DATABASE_URL="postgresql://user:password@localhost:5432/logicbit?schema=public"

# App
PORT=3005
BRAND_NAME="LogicBit"
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
# Public address of the website, used in unsubscribe links (defaults to the first CORS_ORIGIN)
APP_URL="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-this-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# Media Upload (local disk by default; switch to S3-compatible in production)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# --- The following require YOUR business decisions & real credentials.
# --- Backend code is structured to plug these in later without refactoring.

# Payment Gateway (choose one: stripe / esewa / khalti)
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""

# SMS Provider (e.g. Twilio, Sparrow SMS)
SMS_PROVIDER=""
SMS_API_KEY=""

# Email Provider (e.g. SendGrid, SES)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""

# Claude API (for AI Chatbot, Phase 4-5)
ANTHROPIC_API_KEY=""

# Google Cloud Translation API (for menu multi-language auto-translate)
# Get from: Google Cloud Console → APIs & Services → Enable "Cloud Translation API" → Create API Key
GOOGLE_TRANSLATE_API_KEY=""

# Platform Staff Bootstrap (पहिलो Platform Admin — npm run prisma:seed चलाउँदा बन्छ)
PLATFORM_ADMIN_EMAIL="admin@logicbit.local"
PLATFORM_ADMIN_PASSWORD="ChangeMe123!"

# Shown in order confirmation emails (leave empty to omit)
SUPPORT_EMAIL=""

# Shared secret an external delivery service sends in the x-delivery-secret header (leave empty to refuse all delivery webhooks)
DELIVERY_WEBHOOK_SECRET=""

# Uber Direct (Uber couriers for your own orders). Leave empty to keep using our own riders.
UBER_DIRECT_CLIENT_ID=""
UBER_DIRECT_CLIENT_SECRET=""
UBER_DIRECT_CUSTOMER_ID=""
UBER_DIRECT_SIGNING_KEY=""

# PayPay (restaurant orders). Each restaurant adds its own keys under Settings > Payments.
# Sandbox by default; for live payments use https://apigw.paypay.ne.jp
PAYPAY_BASE_URL="https://apigw.sandbox.paypay.ne.jp"
# Where PayPay sends the customer back after paying (the Next.js site)
FRONTEND_URL="http://localhost:3000"
