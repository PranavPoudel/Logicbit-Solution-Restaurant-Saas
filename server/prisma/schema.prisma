generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// TENANT & AUTH
// =========================================================

model Tenant {
  id               String    @id @default(uuid())
  name             String
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users            User[]
  restaurants      Restaurant[]
  roles            Role[]
  categories       Category[]
  menuItems        MenuItem[]
  modifierGroups   ModifierGroup[]
  orders           Order[]
  restaurantTables RestaurantTable[]  // 🆕 Added
  deliveryPartners DeliveryPartner[]
  reservations     Reservation[]      // 🆕 Added
  chatSessions     ChatSession[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  isSuperAdmin Boolean  @default(false) // Tenant भित्रैको सर्वोच्च (Owner) — register गर्दा auto true हुन्छ
  isActive     Boolean  @default(true)
  // Defaults to true on purpose: every account that already exists (and staff an owner invites) counts as verified.
  // Only self sign-up creates an unverified account, by setting this to false explicitly.
  emailVerified Boolean @default(true)
  failedLogins  Int     @default(0)
  lockedUntil   DateTime?
  tokenVersion  Int     @default(0) // bumping this signs the account out of every device
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  roles  UserRole[]

  @@index([tenantId])
}

model Role {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// =========================================================
// RESTAURANT (with Geolocation for Near-Me Discovery)
// =========================================================

// DeliveryMode — Order.deliveryHandledBy मा प्रयोग हुन्छ। यो restaurant-wide
// global setting होइन — प्रत्येक order को distance अनुसार checkout बेलैमा
// calculate भएर record हुन्छ (Restaurant.selfDeliveryRadiusKm भित्र भए
// SELF_DELIVERY, बाहिर तर maxDeliveryRadiusKm भित्र भए THIRD_PARTY)।
enum DeliveryMode {
  SELF_DELIVERY
  THIRD_PARTY
}

enum DeliveryFeeType {
  FREE
  FLAT
  PER_KM
}

// =========================================================
// CUISINE (Managed taxonomy — Platform Admin ले नियन्त्रण गर्ने)
// =========================================================

// Cuisine — "Nepali", "Japanese", "Thai", "Fast Food" जस्ता cuisine/style
// टाइप। यो free-text होइन — Platform Admin ले manage गर्ने एउटै master
// list हो, ताकि सबै restaurant मा उही standardized नाम प्रयोग होस्
// (search/filter/analytics सधैं सही काम गरोस्), र frontend ले dropdown/
// checklist देखाउन सकोस् (free text input होइन)।
model City {
  id           String   @id @default(uuid())
  name         String
  nameJa       String?
  country      String
  latitude     Float
  longitude    Float
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([name, country])
}

model Cuisine {
  id       String  @id @default(uuid())
  name     String  @unique
  slug     String  @unique
  iconUrl  String?
  isActive Boolean @default(true)

  restaurants RestaurantCuisine[]
}

model RestaurantCuisine {
  id           String @id @default(uuid())
  restaurantId String
  cuisineId    String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  cuisine    Cuisine    @relation(fields: [cuisineId], references: [id])

  @@unique([restaurantId, cuisineId])
}

model Restaurant {
  id       String @id @default(uuid())
  coupons         Coupon[]
  tenantId String
  name     String
  slug     String @unique

  // Geolocation — Near-Me feature को लागि
  latitude         Float?
  longitude        Float?
  address          String?
  phone            String?
  refundPolicy     String?
  city             String?
  state            String?
  country          String?
  postalCode       String?


  subscriptionMode SubscriptionMode @default(MANUAL)

  // Discovery / Filter fields
  priceRange   String?
  avgRating    Float    @default(0)
  totalReviews Int      @default(0)
  totalOrders  Int      @default(0)
  isOpen       Boolean  @default(true)
  // Weekly schedule: [{ day: 0-6 (Sun-Sat), closed, shifts: [{ open: "HH:mm", close: "HH:mm" }] }]. Null means no schedule, only isOpen applies.
  openingHours Json?
  timezone     String   @default("Asia/Kathmandu")
  supportsDelivery Boolean @default(true)
  supportsPickup   Boolean @default(true)
  supportsDineIn   Boolean @default(false)

  maxActivePromotions Int          @default(5)
  maxDiscountCap      Float        @default(50) // Maximum flat amount or percentage allowed without admin approval
  allowedCouponTypes  CouponType[] @default([PERCENTAGE, FLAT])

  maxActiveBanners    Int          @default(3)
  maxActivePopups     Int          @default(1)

  // --- Distance-tiered Delivery Settings (owner ले आफैं तोक्ने) ---
  // 0 → selfDeliveryRadiusKm         : Restaurant आफैंले deliver गर्छ
  // selfDeliveryRadiusKm → maxDeliveryRadiusKm : Third-party delivery person
  // maxDeliveryRadiusKm भन्दा बाहिर  : Delivery नै उपलब्ध छैन
  selfDeliveryRadiusKm   Float @default(0)   // 0 राख्दा "आफैं कहिल्यै deliver गर्दैन" भन्ने अर्थ हुन्छ
  maxDeliveryRadiusKm    Float @default(5)   // यो भन्दा टाढा भए order नै लिइँदैन

  selfDeliveryFeeType    DeliveryFeeType @default(FREE)
  selfDeliveryFlatFee    Float @default(0)
  selfDeliveryPerKmFee   Float @default(0)

  thirdPartyFeeType      DeliveryFeeType @default(PER_KM)
  thirdPartyBaseFee      Float @default(30)  // Base/pickup fee (जति टाढा भए पनि यति त लाग्छ)
  thirdPartyPerKmFee     Float @default(15)  // प्रति km थप शुल्क
  cancellationWindowMinutes Int @default(5)
  platformCommissionPercent Float @default(10) // यो restaurant सँग सम्झौता भएको commission दर — तपाईं (platform owner) को आम्दानी यहीँबाट calculate हुन्छ

  // Branding / SEO
  logoUrl        String?
  coverImageUrl  String?
  primaryColor   String? @default("#E53E3E")
  secondaryColor String? @default("#2D3748")
  heroHeading    String?
  heroSubheading String?
  domain         String?
  subdomain      String?
  theme          Json?
  seoTitle       String?
  seoDescription String?
  locale         String  @default("en")
  currencyCode   String  @default("NPR")

  // --- PayPay Integration (Per-Restaurant Credentials) ---
  // These must be encrypted at rest in production using your preferred encryption service.
  paypayMerchantId String?
  paypayApiKey     String?
  paypayApiSecret  String?

   // --- Enabled Payment Methods ---
  supportsCod          Boolean @default(true)
  supportsCreditCard   Boolean @default(false)
  supportsEsewa        Boolean @default(false)
  supportsKhalti       Boolean @default(false)
  supportsIps          Boolean @default(false)
  supportsPhonePay     Boolean @default(false)
  supportsPaypay       Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  categories     Category[]
  menuItems      MenuItem[]
  modifierGroups ModifierGroup[]
  orders         Order[]
  reviews        Review[]
  favoritedBy    CustomerFavorite[]
  cuisines       RestaurantCuisine[]

  tables         RestaurantTable[]
  deliveryPartners DeliveryPartner[]
  reservations   Reservation[]
  chatSessions   ChatSession[]

  @@index([tenantId])
  @@index([latitude, longitude])
  @@index([city])
}

// =========================================================
// MENU
// =========================================================

model Category {
  id              String    @id @default(uuid())
  tenantId        String
  restaurantId    String
  name            String
  nameJa          String?   // 🆕 Japanese Name
  description     String?
  descriptionJa   String?   // 🆕 Japanese Description
  image           String?
  displayOrder    Int       @default(0)
  isFeatured      Boolean   @default(false)
  isOnHomepage    Boolean   @default(false) // 🆕 Show on homepage
  isActive        Boolean   @default(true)
  deletedAt       DateTime? // 🆕 Soft delete for Trash
  parentId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems  MenuItem[]

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  @@index([restaurantId])
  @@index([parentId])
}

model MenuItem {
  id                     String    @id @default(uuid())
  tenantId               String
  restaurantId           String
  categoryId             String
  name                   String
  nameJa                 String?   // 🆕 Japanese Name
  description            String?
  descriptionJa          String?   // 🆕 Japanese Description
  price                  Float
  costPrice              Float?
  image                  String?
  galleryImages          Json?     // 🆕 Array of image URLs
  isAvailable            Boolean   @default(true)
  isFeatured             Boolean   @default(false)
  isVegetarian           Boolean   @default(false)
  isVegan                Boolean   @default(false)
  spiceLevel             String?   // e.g., "MILD", "MEDIUM", "HOT"
  allergenInfo           String?
  ingredients            String?
  calories               Int?
  displayOrder           Int       @default(0)
  preparationTimeMinutes Int?
  homepageSections       Json?     // 🆕 e.g., ["TODAYS_SPECIAL", "BEST_SELLER"]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime? // 🆕 Soft delete for Trash

  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  restaurant     Restaurant               @relation(fields: [restaurantId], references: [id])
  category       Category                 @relation(fields: [categoryId], references: [id])
  modifierGroups MenuItemModifierGroup[]
  orderItems     OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model ModifierGroup {
  id           String   @id @default(uuid())
  tenantId     String
  restaurantId String
  name         String
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1)
  isRequired   Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id])
  restaurant Restaurant               @relation(fields: [restaurantId], references: [id])
  options    ModifierOption[]
  menuItems  MenuItemModifierGroup[]

  @@index([restaurantId])
}

model ModifierOption {
  id              String   @id @default(uuid())
  tenantId        String
  modifierGroupId String
  name            String
  extraPrice      Float    @default(0)
  isAvailable     Boolean  @default(true)
  allergenInfo    String?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@index([modifierGroupId])
}

model MenuItemModifierGroup {
  id              String @id @default(uuid())
  menuItemId      String
  modifierGroupId String

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([menuItemId, modifierGroupId])
}

// =========================================================
// CUSTOMER
// =========================================================

model Customer {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?
  isGuest      Boolean  @default(false)
  isActive     Boolean  @default(true)
  // Defaults to true on purpose (see User.emailVerified): only self sign-up sets it to false.
  emailVerified Boolean @default(true)
  failedLogins  Int     @default(0)
  lockedUntil   DateTime?
  tokenVersion  Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]
  reviews   Review[]
  favorites CustomerFavorite[]
  chatSessions ChatSession[]
  socialAccounts SocialAccount[]
}

enum AccountType {
  CUSTOMER
  OWNER
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// A one-time emailed code. Only an HMAC of the code is stored, never the code itself.
model OtpCode {
  id          String     @id @default(uuid())
  accountType AccountType
  accountId   String
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([accountType, accountId, purpose])
}

/// Links a Google (or other provider) identity to a customer.
model SocialAccount {
  id             String   @id @default(uuid())
  provider       String
  providerUserId String
  customerId     String
  createdAt      DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([customerId])
}

/// Single-use, short-lived code the website swaps for tokens after a Google login (no token in the URL).
model SocialLoginCode {
  id         String    @id @default(uuid())
  codeHash   String    @unique
  customerId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model CustomerAddress {
  id          String  @id @default(uuid())
  customerId  String
  label       String
  latitude    Float
  longitude   Float
  fullAddress String
  isDefault   Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model CustomerFavorite {
  id           String @id @default(uuid())
  customerId   String
  restaurantId String

  customer   Customer   @relation(fields: [customerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([customerId, restaurantId])
}

// =========================================================
// ORDER
// =========================================================

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  CREDIT_CARD
  ESEWA
  KHALTI
  IPS
  PHONEPAY
  PAYPAY
}

enum CancelledBy {
  CUSTOMER
  RESTAURANT
  SYSTEM
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
  NOT_APPLICABLE
}

enum RefundMethod {
  CASH
  BANK_TRANSFER
  PAYPAY
  OTHER
}

model Order {
  id           String   @id @default(uuid())
  tenantId     String
  restaurantId String
  customerId   String

  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  orderType   OrderType

  subtotal       Float
  deliveryFee    Float  @default(0)
  tax            Float  @default(0)
  discountAmount Float  @default(0)
  couponCode     String?
  total          Float
  currencyCode   String @default("NPR") // the restaurant's currency when the order was placed
  platformCommissionAmount Float @default(0) // तपाईंको (platform owner) कमाई — यही order बाट कति कमिशन बन्यो

  deliveryLatitude  Float?
  deliveryLongitude Float?
  deliveryAddress   String?
  deliveryDistanceKm Float?
  deliveryHandledBy DeliveryMode? // यही specific order को लागि Self हो कि Third-party हो भनेर checkout बेला नै तय भएर record हुन्छ

  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD)

 // --- Printing ---
  printedAt     DateTime?       //  Null = unprinted, Timestamp = printed

  // --- Cancellation tracking ---
  cancelledBy     CancelledBy?
  cancellationReason String?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id])
  customer      Customer           @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  review        Review?
  statusHistory OrderStatusHistory[]
  refund        Refund?
  delivery      Delivery?

  @@index([restaurantId])
  @@index([customerId])
}

// OrderStatusHistory — हरेक status change को audit trail।
// "कहिले, कसले, के status मा बदल्यो" भन्ने पूरा इतिहास — WooCommerce को
// order notes/log जस्तै, dispute भएमा वा customer support को लागि अनिवार्य।
model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?        // userId वा customerId, जसले बदल्यो
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// Refund — Order cancel/return भएपछि पैसा फिर्ता को track।
// COD भए "NOT_APPLICABLE" (पैसा तिरिएकै थिएन), Online payment भए
// gateway बाट फिर्ता processing track गर्ने।
model Refund {
  id            String        @id @default(uuid())
  orderId       String        @unique
  amount        Float
  status        RefundStatus  @default(PENDING)
  reason        String?
  method        RefundMethod?
  reference     String?
  failureReason String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id                String @id @default(uuid())
  orderId           String
  menuItemId        String
  quantity          Int
  unitPrice         Float
  subtotal          Float
  selectedModifiers Json?
  notes             String?

  
  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

// =========================================================
// COUPON / DISCOUNT
// =========================================================

enum CouponType {
  PERCENTAGE
  FLAT
}

enum ApprovalStatus {
  APPROVED
  PENDING_APPROVAL
  REJECTED
}

model Coupon {
  id                  String     @id @default(uuid())
  tenantId            String
  restaurantId   String?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id])
  code                String?
  type                CouponType
  value               Float
  maxDiscount         Float?
  minOrderAmount      Float?     @default(0)
  usageLimit          Int?
  usageLimitPerCustomer Int?     @default(1)
  usedCount           Int        @default(0)
  validFrom           DateTime   @default(now())
  validUntil          DateTime?
  isActive            Boolean    @default(true)
  isAutoApply         Boolean    @default(false)
  approvalStatus ApprovalStatus @default(APPROVED)
  deletedAt           DateTime?  // 🆕 Added for Trash functionality
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  usages CouponUsage[]

  @@unique([tenantId, code])
  @@index([restaurantId])
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  customerId     String
  orderId        String   @unique
  discountAmount Float
  usedAt         DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([customerId])
}

// =========================================================
// REVIEW
// =========================================================

model Review {
  id           String   @id @default(uuid())
  restaurantId String
  customerId   String
  orderId      String?  @unique
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])

  @@index([restaurantId])
}

// =========================================================
// DELIVERY
// =========================================================

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  FAILED
}

enum RiderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model DeliveryPerson {
  id               String              @id @default(uuid())
  tenantId         String?
  name             String
  phone            String              @unique
  email            String?             @unique
  passwordHash     String
  vehicleType      String?
  isAvailable      Boolean             @default(true)
  isActive         Boolean             @default(true)
  approvalStatus   RiderApprovalStatus @default(PENDING) 
  currentLatitude  Float?
  currentLongitude Float?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  deliveries       Delivery[]
}

model Delivery {
  id               String         @id @default(uuid())
  orderId          String         @unique
  deliveryPersonId String?
  status           DeliveryStatus @default(UNASSIGNED)
  earningAmount    Float          @default(0) // यो delivery बाट rider ले कति कमाउने (Order.deliveryFee बाट calculate)
  assignedAt       DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  failureReason    String?
  provider         String?
  externalRef      String?
  driverName       String?
  driverPhone      String?
  driverVehicle    String?
  trackingUrl      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order          Order           @relation(fields: [orderId], references: [id])
  deliveryPerson DeliveryPerson? @relation(fields: [deliveryPersonId], references: [id])

  @@index([deliveryPersonId])
  @@index([provider, externalRef])
}

// =========================================================
// SETTLEMENT (COD Commission Collection — Business Critical)
// =========================================================

enum SettlementStatus {
  PENDING   // Invoice बनियो, restaurant ले अझै तिरेको छैन
  PAID      // Restaurant ले platform लाई commission तिरिसक्यो
  OVERDUE
}

// Settlement — किनभने COD मा पैसा customer बाट restaurant सम्म सिधै
// जान्छ (platform बीचमा पर्दैन), तपाईंको commission स्वतः कहिल्यै उठ्दैन।
// यसैले periodic (साप्ताहिक/मासिक) रूपमा "यो अवधिका सबै COD order मिलाएर
// यति commission तिर्नुपर्छ" भन्ने invoice/statement बनाइन्छ, र restaurant
// ले त्यो अलग्गै (bank transfer/manual) तिर्छन्।
model Settlement {
  id             String           @id @default(uuid())
  tenantId       String
  restaurantId   String
  periodStart    DateTime
  periodEnd      DateTime
  totalOrders    Int
  totalCodAmount Float            // COD बाट collect भएको कुल पैसा (restaurant ले लिएको)
  commissionDue  Float            // तपाईंलाई तिर्नुपर्ने commission
  status         SettlementStatus @default(PENDING)
  paidAt         DateTime?
  paymentReference String?
  createdAt      DateTime         @default(now())

  @@index([restaurantId])
}

// =========================================================
// SUBSCRIPTION / MEMBERSHIP (Platform Billing — Domain-renewal जस्तो)
// =========================================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionMode {
  MANUAL
  AUTO
}

// SubscriptionPlan — "Free", "Monthly", "Quarterly", "1 Year"... जस्ता
// membership plan। Platform Admin ले यी बनाउँछन्।
model SubscriptionPlan {
  id              String  @id @default(uuid())
  name            String  @unique
  durationMonths  Int     // 0 = Free/lifetime (कहिल्यै expire नहुने)
  price           Float   @default(0)
  isActive        Boolean @default(true)

  subscriptions RestaurantSubscription[]
}

// RestaurantSubscription — एउटा restaurant को हालको membership status।
// Domain renewal जस्तै — expiryDate नजिकिँदा notification जान्छ,
// auto-renew भए आफैं renew हुन्छ, नभए expire भएर restaurant suspend हुन्छ।
model RestaurantSubscription {
  id               String             @id @default(uuid())
  restaurantId     String             @unique
  planId           String
  startDate        DateTime           @default(now())
  expiryDate       DateTime?          // null = Free/lifetime plan, कहिल्यै expire हुँदैन
  status           SubscriptionStatus @default(ACTIVE)
  autoRenew        Boolean            @default(false)
  lastReminderSentDaysBefore Int?     // 30/15/7/3/1 मध्ये कुनसम्म पठाइसक्यो (duplicate notification रोक्न)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id])
}

enum SubscriptionPaymentMethod {
  PAYPAY
  CARD
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
}

model SubscriptionPayment {
  id                String                    @id @default(uuid())
  tenantId          String
  restaurantId      String
  planId            String
  method            SubscriptionPaymentMethod
  amount            Float
  currencyCode      String
  status            SubscriptionPaymentStatus @default(PENDING)
  providerReference String?
  paidAt            DateTime?
  createdAt         DateTime                  @default(now())

  @@index([restaurantId, createdAt])
  @@index([providerReference])
}

// =========================================================
// PLATFORM STAFF RBAC (Super Admin को आफ्नै team management)
// =========================================================

// PlatformPermission — Platform-level action हरूको global list (जस्तै
// "restaurant suspend गर्ने", "commission बदल्ने")। यो tenant-level
// Permission भन्दा फरक हो — यो LogicBit को आफ्नै internal team को लागि हो।
model PlatformPermission {
  id          String @id @default(uuid())
  name        String @unique
  description String?

  roles PlatformRolePermission[]
}

model PlatformRole {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  permissions PlatformRolePermission[]
  staff       PlatformStaff[]
}

model PlatformRolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       PlatformRole       @relation(fields: [roleId], references: [id])
  permission PlatformPermission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// PlatformStaff — LogicBit को आफ्नै team member (तपाईं आफैं + तपाईंले
// नियुक्त गरेको support/finance staff)। Restaurant owner को User model
// भन्दा पूर्ण रूपमा छुट्टै — यो कहिल्यै tenant सँग बाँधिँदैन।
model PlatformStaff {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  role PlatformRole @relation(fields: [roleId], references: [id])
}

// =========================================================
// ACTIVITY LOG (Super Admin Dashboard — audit trail)
// =========================================================

// ActivityLog — प्रत्येक महत्वपूर्ण घटना (order भयो, menu बदलियो, commission
// बदलियो, ad approve भयो...) यहाँ log हुन्छ। Super Admin dashboard ले
// restaurant-wise यो data देखाउँछ — "यो restaurant मा के-के भइरहेको छ"
// भन्ने पूरा पारदर्शी history।
model ActivityLog {
  id           String   @id @default(uuid())
  tenantId     String?
  restaurantId String?
  actorType    String   // "OWNER" | "CUSTOMER" | "DELIVERY" | "PLATFORM_ADMIN" | "SYSTEM"
  actorId      String?
  action       String   // जस्तै "ORDER_CREATED", "MENU_ITEM_UPDATED", "COMMISSION_CHANGED"
  description  String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([restaurantId])
  @@index([tenantId])
  @@index([action])
}

// =========================================================
// ADVERTISEMENT (Platform-wide paid promotion — नयाँ आम्दानी स्रोत)
// =========================================================

enum AdPlacementType {
  HOMEPAGE_BANNER // Discovery homepage (सबै customer ले देख्ने, restaurant-specific होइन) मा banner
  SEARCH_BOOST    // Near-me ranking मा माथि देखिने ("Sponsored" tag सहित)
  POPUP           // Website खोल्नेबित्तिकै platform-wide popup ad
}

enum AdStatus {
  PENDING   // Owner ले request गर्यो, payment/approval बाँकी
  ACTIVE    // Platform Admin ले payment confirm गरेर activate गर्यो
  REJECTED
  EXPIRED
}

// Advertisement — Restaurant owner ले पैसा तिरेर platform-wide visibility
// किन्ने (जस्तै homepage मा सबैले देख्ने banner, वा near-me search मा
// "Sponsored" tag सहित माथि देखिने)। यो प्रत्येक restaurant को आफ्नै
// storefront भन्दा फरक हो — यो सम्पूर्ण platform का customer ले देख्ने हो।
// 
// Workflow: Owner request गर्छ (PENDING) → Platform Admin ले payment
// confirm गरेर ACTIVE बनाउँछ → endDate cross भएपछि EXPIRED।
model Advertisement {
  id            String          @id @default(uuid())
  tenantId      String
  restaurantId  String
  placementType AdPlacementType
  title         String
  imageUrl      String?
  linkUrl       String?
  startDate     DateTime
  endDate       DateTime
  amountPaid    Float           @default(0)
  priority      Int             @default(0) // धेरै ad एकैचोटि भए, यसले क्रम तोक्छ
  status        AdStatus        @default(PENDING)
  rejectionReason String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([restaurantId])
  @@index([status, placementType])
}

// =========================================================
// STOREFRONT (Restaurant's own customizable website)
// =========================================================

// StorefrontBanner — Homepage मा देखिने slider/banner image हरू।
// displayOrder ले नै drag-and-drop बाट owner ले मिलाएको क्रम राख्छ —
// frontend मा customer ले drag गरेपछि, backend मा यही field अपडेट हुन्छ।
model StorefrontBanner {
  id           String   @id @default(uuid())
  tenantId     String
  restaurantId String
  imageUrl     String
  title        String?
  subtitle     String?
  linkUrl      String?  // Click गर्दा कहाँ जाने (menu item, coupon, external URL)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId])
}

// StorefrontConfig — About/Contact text, अनि homepage मा section हरू कुन
// क्रममा देखिने (drag-and-drop से owner ले तोकेको) भन्ने layout config।
// एउटा restaurant मा एउटै मात्र config हुन्छ (@@unique)।
model StorefrontConfig {
  id             String   @id @default(uuid())
  tenantId       String
  restaurantId   String   @unique
  aboutText      String?
  contactPhone   String?
  contactEmail   String?
  contactAddress String?
  socialLinks    Json?
  
  // Example: [{ "id": "menu", "isVisible": true, "titleEn": "Our Menu", "titleJa": "メニュー" }]
  sectionSettings Json @default("[]") 
  
  updatedAt      DateTime @updatedAt
}
// StorefrontPopup — Website खोल्ने बित्तिकै देखिने offer/notification popup।
// Schedule (startDate/endDate) राखिएको छ ताकि owner ले "यो weekend मात्र
// यो offer देखाऊ" जस्तो time-bound campaign चलाउन सकून्।
enum PopupType {
  DISCOUNT
  NEW_DISH
  EVENT
  ANNOUNCEMENT
  EXTERNAL_AD
}

model StorefrontPopup {
  id           String    @id @default(uuid())
  tenantId     String
  restaurantId String
  title        String
  message      String?
  imageUrl     String?
  ctaText      String?   // Button को text, जस्तै "Order Now"
  ctaLink      String?
  type         PopupType @default(ANNOUNCEMENT)
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([restaurantId])
}

// =========================================================
// TRANSLATION (Google Translate API cache)
// =========================================================

model TranslationCache {
  id             String   @id @default(uuid())
  sourceTextHash String   // SHA-256 hash of original text (fast lookup को लागि)
  sourceText     String
  targetLang     String   // "ja", "ne", "en"...
  translatedText String
  createdAt      DateTime @default(now())

  @@unique([sourceTextHash, targetLang])
}

// =========================================================
// MEDIA (Image Upload)
// =========================================================

model Media {
  id           String   @id @default(uuid())
  tenantId     String
  restaurantId String?
  url          String
  key          String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

// =========================================================
// NOTIFICATION
// =========================================================

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum CustomerEmailAudience {
  ALL
  ONE
}

model CustomerEmail {
  id             String                @id @default(uuid())
  tenantId       String
  restaurantId   String
  audience       CustomerEmailAudience
  customerId     String?
  orderId        String?
  subject        String
  body           String
  recipientCount Int
  sentCount      Int                   @default(0)
  failedCount    Int                   @default(0)
  createdAt      DateTime              @default(now())

  recipients CustomerEmailRecipient[]

  @@index([restaurantId, createdAt])
}

enum CustomerEmailRecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// One row per customer of a broadcast. A worker sends PENDING rows a few at a time,
// so a long list survives a restart and shows progress in the history.
model CustomerEmailRecipient {
  id         String                       @id @default(uuid())
  emailId    String
  customerId String
  email      String
  status     CustomerEmailRecipientStatus @default(PENDING)
  attempts   Int                          @default(0)
  createdAt  DateTime                     @default(now())
  sentAt     DateTime?

  customerEmail CustomerEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([emailId])
}

// A customer who unsubscribed from one restaurant's emails.
model EmailUnsubscribe {
  id           String   @id @default(uuid())
  customerId   String
  restaurantId String
  createdAt    DateTime @default(now())

  @@unique([customerId, restaurantId])
  @@index([restaurantId])
}

model Notification {
  id         String              @id @default(uuid())
  tenantId   String?
  customerId String?
  channel    NotificationChannel
  recipient  String
  subject    String?
  body       String
  status     NotificationStatus  @default(PENDING)
  createdAt  DateTime            @default(now())
  sentAt     DateTime?

  @@index([tenantId])
  @@index([customerId])
}

// =========================================================
// TABLES & RESERVATIONS
// =========================================================

model RestaurantTable {
  id           String   @id @default(uuid())
  tenantId     String
  restaurantId String
  name         String              // e.g., "Table 01", "T-01", "Bar Seat 3"
  capacity     Int                 // max guests
  zone         String?             // e.g., "Indoor", "Outdoor", "Patio"
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?           // soft delete

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  reservations Reservation[]

  @@index([restaurantId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id              String            @id @default(uuid())
  tenantId        String
  restaurantId    String
  tableId         String?           // nullable — can be unassigned initially
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  partySize       Int
  reservationDate DateTime          // the date of the reservation
  reservationTime String            // e.g., "13:00"
  durationMinutes Int      @default(60)
  status          ReservationStatus @default(PENDING)
  notes           String?           // customer message / special request
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?         // soft delete (Trash)

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  restaurant Restaurant      @relation(fields: [restaurantId], references: [id])
  table      RestaurantTable? @relation(fields: [tableId], references: [id])

  @@index([restaurantId])
  @@index([reservationDate])
  @@index([status])
}

enum DeliveryPartnerFeeType {
  FLAT
  PERCENT
}

model DeliveryPartner {
  id           String                 @id @default(uuid())
  tenantId     String
  restaurantId String
  name         String
  contactName  String?
  contactPhone String?
  accountId    String?
  feeType      DeliveryPartnerFeeType @default(PERCENT)
  feeValue     Float                  @default(0)
  notes        String?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

// =========================================================
// CHATBOT
// =========================================================

// One visitor conversation on one restaurant's storefront. tenantId is copied
// from the restaurant when the chat starts so owners can be filtered cheaply.
// The unguessable session id doubles as the visitor's access token.
model ChatSession {
  id           String    @id @default(uuid())
  tenantId     String
  restaurantId String
  customerId   String?              // null for guests
  visitorName  String?
  takenOver    Boolean   @default(false) // true once an owner/admin replied -> bot stays quiet
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]

  @@index([tenantId, updatedAt])
  @@index([restaurantId])
  @@index([customerId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  from      String   // "user" | "bot" | "owner" | "admin" (set by the server, never the client)
  text      String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
